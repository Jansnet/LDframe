# ───────────────────────────────────────────────────────────────
# Future Skills Platform — environment template
# Copy to `.env` for local dev, or `.env.production` for deployment.
# ───────────────────────────────────────────────────────────────

# ── Core ──
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ── Database (Postgres) ──
DATABASE_URL=postgresql://fsp:fsp@db:5432/fsp

# ── AI Coach (Anthropic or compatible proxy) ──
# Leave ANTHROPIC_API_KEY unset to run the platform in "content-only" mode
# without the AI coach. For air-gapped deployments, point ANTHROPIC_BASE_URL
# at an on-prem LLM gateway (e.g. LiteLLM) that speaks the Anthropic API.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
COACH_MODEL=claude-sonnet-4-6

# ── Auth ──
# Options: local | oidc | saml
AUTH_MODE=local
AUTH_SECRET=change-me-use-openssl-rand-base64-32
# OIDC (for enterprise SSO). Used when AUTH_MODE=oidc.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── Observability (optional) ──
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=future-skills-platform

# ── Tenancy ──
# "single" for one org per deployment (typical for intranet self-host)
# "multi" to enable org switcher and row-level isolation
TENANCY_MODE=single
DEFAULT_LOCALE=de
SUPPORTED_LOCALES=de,en
