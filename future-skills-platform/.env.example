# ───────────────────────────────────────────────────────────────
# Future Skills Platform — environment template
# Copy to `.env` for local dev, or `.env.production` for deployment.
# ───────────────────────────────────────────────────────────────

# ── Core ──
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ── Database (Postgres) ──
DATABASE_URL=postgresql://fsp:fsp@db:5432/fsp

# ── AI Coach (Anthropic-API or compatible proxy) ──
# Leave ANTHROPIC_API_KEY unset to run the platform in "content-only" mode
# without the AI coach.
#
# Three supported provider setups, all via the Anthropic SDK:
#
#   1. Anthropic direct (default)
#        ANTHROPIC_API_KEY=sk-ant-...
#        ANTHROPIC_BASE_URL=   (leave empty)
#        COACH_MODEL=claude-haiku-4-5
#
#   2. OpenRouter (anthropic-compatible endpoint, often cheaper, easy A/B)
#        ANTHROPIC_API_KEY=sk-or-v1-...
#        ANTHROPIC_BASE_URL=https://openrouter.ai/api
#        COACH_MODEL=anthropic/claude-haiku-4-5
#      Other OpenRouter slugs that work via the Anthropic-compat endpoint:
#        anthropic/claude-sonnet-4-6      — higher quality, ~3x cost
#        anthropic/claude-opus-4-8        — overkill for coach, ~15x cost
#
#   3. Self-hosted LLM gateway speaking the Anthropic API (LiteLLM etc.)
#        ANTHROPIC_API_KEY=<gateway-key>
#        ANTHROPIC_BASE_URL=https://llm.intra.example.com
#        COACH_MODEL=claude-haiku-4-5
#
# Default chosen for the cost / German-tone / instruction-following balance.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
COACH_MODEL=claude-haiku-4-5

# ── Auth ──
# Options: local | oidc | saml
AUTH_MODE=local
AUTH_SECRET=change-me-use-openssl-rand-base64-32
# OIDC (for enterprise SSO). Used when AUTH_MODE=oidc.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── Observability (optional) ──
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=future-skills-platform

# ── Tenancy ──
# "single" for one org per deployment (typical for intranet self-host)
# "multi" to enable org switcher and row-level isolation
TENANCY_MODE=single
DEFAULT_LOCALE=de
SUPPORTED_LOCALES=de,en
