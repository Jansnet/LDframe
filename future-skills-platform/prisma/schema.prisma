// Future Skills Platform — data layer
//
// Design principle: skill content (definitions, analogies, exercises) lives in
// the codebase as typed modules (src/content/skills/*.ts) so it is versioned,
// reviewable and portable. This schema only stores mutable state: users,
// progress, reflections, habits, plan items.
//
// Multi-tenant aware via Organization row-level scoping.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  locale    String   @default("de")
  createdAt DateTime @default(now())

  users         User[]
  teams         Team[]
  customSkills  CustomSkill[]
  customExercises CustomExercise[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  locale         String   @default("de")
  // Free-text role description + structured tags for the Job-Role Translator.
  roleText       String?
  roleTags       Json?    // { industry, seniority, context }
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  assessments       Assessment[]
  planItems         PlanItem[]
  attempts          ExerciseAttempt[]
  reflections       Reflection[]
  habits            Habit[]
  roleTranslations  RoleTranslation[]
  teamMemberships   TeamMember[]
  // Behavior-change layer (HILL backbone, not surfaced as such in UI)
  gapClassifications GapClassification[]
  skillLevels       SkillLevel[]
  identityStatements IdentityStatement[]
  behaviorEvidences BehaviorEvidence[]
  artefacts         Artefact[]
  streaks           Streak[]
  badges            Badge[]
  ownedCaseClinics       CaseClinic[] @relation("CaseClinicOwner")
  facilitatedCaseClinics CaseClinic[] @relation("CaseClinicFacilitator")
  caseClinicParticipations CaseClinicParticipant[]

  @@index([organizationId])
}

model Team {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  members        TeamMember[]
  cohorts        Cohort[]
}

model TeamMember {
  id     String @id @default(cuid())
  userId String
  teamId String
  role   String @default("member") // member | lead | ld_admin
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model Cohort {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  skillSlug String
  startedAt DateTime @default(now())
  endsAt    DateTime?
}

// ── Assessment & planning ──────────────────────────────────────

model Assessment {
  id        String   @id @default(cuid())
  userId    String
  skillSlug String   // foreign key into code-level skill registry
  level     Int      // self-rated 1..5
  scenarioScores Json? // { item_id: score }
  takenAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, skillSlug, takenAt])
}

model PlanItem {
  id        String   @id @default(cuid())
  userId    String
  skillSlug String
  phase     String   // foundation | exploration | application | integration
  exerciseId String?
  scheduledFor DateTime?
  status    String   @default("todo") // todo | in_progress | done | skipped
  notes     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ── Exercise interaction ───────────────────────────────────────

model ExerciseAttempt {
  id         String   @id @default(cuid())
  userId     String
  skillSlug  String
  exerciseId String
  // Context this exercise was done in — enables "real work" artefacts.
  artefact   Json?    // arbitrary structured response (checklist ticks, journal, etc.)
  reflection String?
  startedAt  DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, skillSlug, completedAt])
}

model Reflection {
  id        String   @id @default(cuid())
  userId    String
  skillSlug String?  // null = cross-skill weekly reflection
  prompt    String
  response  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Habit {
  id        String   @id @default(cuid())
  userId    String
  skillSlug String
  name      String
  status    String   // new | shifting | strengthened
  trigger   String?  // "when X happens"
  action    String?  // "I do Y"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Job-role translations are cached: the LLM call to adapt a skill to a role
// is expensive, so we memoize per (roleFingerprint, skillSlug, locale).
model RoleTranslation {
  id              String @id @default(cuid())
  userId          String
  skillSlug       String
  roleFingerprint String   // hash of roleText + roleTags
  locale          String
  content         Json     // { meaning, scenarios[], priority }
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roleFingerprint, skillSlug, locale])
  @@index([userId])
}

// ── Org-provided extensions ────────────────────────────────────
// Enterprises can add their own skills / exercises via the admin API without
// forking the codebase. Same schema as code-level content, but org-scoped.

model CustomSkill {
  id             String @id @default(cuid())
  organizationId String
  slug           String
  category       String
  content        Json   // validated against Zod SkillSchema at write time

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
}

model CustomExercise {
  id             String @id @default(cuid())
  organizationId String
  skillSlug      String
  content        Json   // validated against Zod ExerciseSchema at write time

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, skillSlug])
}

// ── Behavior-change layer (HILL backbone, never surfaced as "HILL" in UI) ──
//
// Three backend subsystems:
//   1. Gap Engine        — Urgency + Agency  (GapClassification + IdentityStatement)
//   2. Coach/Cohort      — Collaboration + Hybrid (existing Cohort + future peer space)
//   3. Artefact/Reflect  — Action/Sharing + Assessment-as-Learning (Artefact + BehaviorEvidence)

// Captures the user's 2-question gap-engine answers and the LLM's skill-confidence map.
// Drives onboarding ("here's why we suggest these 3 skills") and re-engagement.
model GapClassification {
  id          String   @id @default(cuid())
  userId      String
  // What we asked + how the user answered. Stored as JSON to allow evolving question sets.
  questions   Json     // { situation: string, intent: string, ... }
  // LLM output: ranked list of skills with rationale text per skill.
  suggestions Json     // [{ skillSlug, confidence, rationale }]
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Lightweight 4-stage self-positioning per skill — Dreyfus-inspired.
// NOT a quiz. Just "where do I stand right now?" Updated freely by user.
// Levels: 1 = heard_of, 2 = basics, 3 = regular_use, 4 = can_teach
model SkillLevel {
  id        String   @id @default(cuid())
  userId    String
  skillSlug String
  level     Int      // 1..4
  rationale String?  // optional 1-line note from the user
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillSlug])
}

// "In 4 weeks I'll say about myself: '...'" — the identity-based anchor for a cycle.
// One active per user per skill at a time.
model IdentityStatement {
  id        String   @id @default(cuid())
  userId    String
  skillSlug String
  statement String   // user's own words
  weeks     Int      @default(4)
  startedAt DateTime @default(now())
  fulfilled Boolean  @default(false)
  closedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, skillSlug])
}

// 3 concrete real situations from the user's past week per skill.
// Replaces Likert self-rating as the assessment baseline.
model BehaviorEvidence {
  id        String   @id @default(cuid())
  userId    String
  skillSlug String
  // Three free-text situations + what the user actually did.
  situations Json    // [{ context, action }, ...]
  capturedAt DateTime @default(now())
  // Optional re-capture after cycle end → enables delta visualization.
  cycleStage String  @default("baseline") // baseline | midpoint | closing
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, skillSlug, capturedAt])
}

// First-class artefact produced by exercises. Powers the "show your work" feed
// in cohorts and gates progress in solo mode (no completion without artefact).
model Artefact {
  id        String   @id @default(cuid())
  userId    String
  skillSlug String
  exerciseId String?
  kind      String   // journal | checklist | list | structured
  content   Json
  visibility String  @default("private") // private | cohort | org
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, skillSlug, createdAt])
}

// ── Gentle gamification ──
// Streaks and badges, but the soft kind: streaks have monthly freezes (no
// shame loop), badges are awarded for substantive achievements (artefacts,
// cycle completion, peer facilitation) — not for clicking around.

model Streak {
  id          String   @id @default(cuid())
  userId      String
  // artefact_weekly | reflection_weekly | cycle_progress
  kind        String
  current     Int      @default(0)
  longest     Int      @default(0)
  // 3 freezes per month — a missed week doesn't break the streak.
  freezesAvailable Int @default(3)
  lastEventAt DateTime?
  pausedUntil DateTime?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}

model Badge {
  id        String   @id @default(cuid())
  userId    String
  // first_artefact | five_artefact_week | identity_fulfilled | cycle_completed |
  // case_clinic_owner | case_clinic_facilitator
  slug      String
  awardedAt DateTime @default(now())
  context   Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
}

// ── Kollegiale Fallberatung (Case Clinic) ──
// 6-phase structured peer consultation, established German group format.
// Works solo (AI as facilitator + steel-man peer) or with 3-6 participants.

model CaseClinic {
  id            String   @id @default(cuid())
  caseOwnerId   String
  facilitatorId String   // can equal caseOwnerId if AI-facilitated solo
  skillSlug     String?
  caseText      String   // the situation the owner brings
  keyQuestion   String?  // distilled question to consult on
  // setup | case | clarify | hypotheses | resources | agreement | done
  phase         String   @default("setup")
  notes         Json?    // per-phase notes captured by facilitator
  scheduledFor  DateTime?
  startedAt     DateTime?
  endedAt       DateTime?
  isSolo        Boolean  @default(false)
  createdAt     DateTime @default(now())

  caseOwner    User @relation("CaseClinicOwner",    fields: [caseOwnerId],   references: [id], onDelete: Cascade)
  facilitator  User @relation("CaseClinicFacilitator", fields: [facilitatorId], references: [id], onDelete: Cascade)
  participants CaseClinicParticipant[]

  @@index([caseOwnerId, createdAt])
}

model CaseClinicParticipant {
  id       String @id @default(cuid())
  clinicId String
  userId   String
  // owner | facilitator | consultant
  role     String @default("consultant")

  clinic CaseClinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId],   references: [id], onDelete: Cascade)

  @@unique([clinicId, userId])
}
